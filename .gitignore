# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.hypothesis/

# Extension build output (test output goes to the system temp folder)
node_modules/
extension/dist/
# Written only by a debugging run with --reporter=html
extension/playwright-report/
extension/test-results/
# Local tooling that plays seats at PokerNow test tables: kept out of the public repo, since
# PokerNow's terms forbid bots
extension/tools/

# Secrets: the API key lives only in .env
.env
.env.*
!.env.example

# Private data: the profiles (only their rulebook is tracked), drafts and data/ stay local
profiles/*
!profiles/_GUIDELINES.md
# Claude Code's per-machine settings
.claude/settings.local.json
drafts/*
!drafts/README.md
/data/

# Editors and OS
.vscode/
.idea/
.DS_Store
*.log

# Third-party data for the corpus checks (scripts/fetch_corpus.py, fetch_hrc_pushfold.py)
tests/corpus/
